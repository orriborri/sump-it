{
  "name": "coffee-brewer-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js frontend for consolidated coffee brewing application (typed REST client over the Rust backend)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "generate-types": "cd ../backend && cargo test export_bindings",
    "check-types-fresh": "npm run generate-types && git diff --exit-code -- lib/generated"
  },
  "dependencies": {
    "@mui/material": "^6.1.3",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^6.1.3",
    "@tanstack/react-query": "^4.36.1",
    "next": "15.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.0.0",
    "eslint": "^8.0.0",
    "eslint-config-next": "15.0.0",
    "postcss": "^8.0.0",
    "tailwindcss": "^3.0.0",
    "typescript": "^5.0.0",
    "tsx": "^4.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
