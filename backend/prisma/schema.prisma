generator client {
  provider = "prisma-client-rs"
  output = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Database-level enums for type safety
enum BrewingMethod {
  V60
  Chemex
  FrenchPress
  AeroPress
  Espresso
  Moka
  ColdBrew
  Other
}

enum GrinderType {
  BurrConical
  BurrFlat
  Blade
  Manual
  Electric
}

// Coffee beans with inventory tracking
model CoffeeBean {
  id              String      @id @default(cuid())
  name            String      @db.VarChar(100)
  origin          String      @db.VarChar(100)
  roastDate       DateTime
  purchaseDate    DateTime
  remainingGrams  Float?      @default(0.0)
  variety         String?     @db.VarChar(100)
  processingMethod String?    @db.VarChar(100)
  isActive        Boolean     @default(true)
  
  // Relationships
  brewingSessions BrewingSession[]
  
  // Timestamps
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  // Indexes
  @@index([isActive])
  @@index([roastDate])
  
  // Validation constraints
  @@map("coffee_beans")
  
  // Custom constraint for remaining grams
  @@check("remaining_grams >= 0 OR remaining_grams IS NULL")
}

// Grinder equipment with setting ranges
model Grinder {
  id              String      @id @default(cuid())
  brand           String      @db.VarChar(100)
  model           String      @db.VarChar(100)
  grinderType     GrinderType
  minSetting      Int         @default(0)
  maxSetting      Int         @default(40)
  scaleType       String?     @db.VarChar(20) // "step", "sliding"
  description     String?     @db.Text
  
  // Relationships
  brewingSessions BrewingSession[]
  
  // Timestamps
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  // Indexes
  @@index([brand])
  @@index([grinderType])
  
  // Validation constraints
  @@map("grinders")
  @@check("min_setting >= 0")
  @@check("max_setting > min_setting")
}

// Brewing sessions - comprehensive tracking
model BrewingSession {
  id                String        @id @default(cuid())
  
  // Equipment selection
  beanId            String
  bean              CoffeeBean    @relation(fields: [beanId], references: [id], onDelete: Cascade)
  grinderId         String
  grinder           Grinder       @relation(fields: [grinderId], references: [id], onDelete: Cascade)
  brewingMethod     BrewingMethod
  
  // Brewing parameters
  grindSetting      Int
  waterTempCelsius  Int?          @db.SmallInt
  brewTimeSeconds   Int?          @db.SmallInt
  coffeeGrams       Float
  waterGrams        Float
  
  // Results and feedback
  rating            Float?
  tastingNotes      String?       @db.Text
  feedback          String?       @db.Text
  suggestions       String?       @db.Text
  isTemplate        Boolean       @default(false)
  
  // Calculated fields (could be computed in app layer)
  coffeeRatio       Float?        // water_grams / coffee_grams
  
  // Timestamps
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  // Indexes
  @@index([beanId])
  @@index([grinderId])
  @@index([brewingMethod])
  @@index([rating])
  @@index([createdAt])
  @@index([isTemplate])
  
  // Validation constraints
  @@map("brewing_sessions")
  
  // Database-level validation from rustyCoffy
  @@check("coffee_grams >= 10.0 AND coffee_grams <= 100.0")
  @@check("water_grams >= 150.0 AND water_grams <= 1700.0")
  @@check("(water_grams / coffee_grams) >= 15.0 AND (water_grams / coffee_grams) <= 17.0")
  @@check("rating IS NULL OR (rating >= 1.0 AND rating <= 10.0)")
  @@check("water_temp_celsius IS NULL OR (water_temp_celsius >= 60 AND water_temp_celsius <= 100)")
  @@check("brew_time_seconds IS NULL OR (brew_time_seconds >= 30 AND brew_time_seconds <= 480)")
  @@check("grind_setting >= 0")
}

// Brew methods reference table (from BeanIt)
model BrewMethod {
  id              String      @id @default(cuid())
  name            String      @unique @db.VarChar(50)
  description     String?     @db.Text
  
  // Timestamps
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  // Indexes
  @@index([name])
  
  @@map("brew_methods")
}

// Feedback and analytics table (from sump-it)
model BrewFeedback {
  id              String      @id @default(cuid())
  sessionId       String      @unique
  session         BrewingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  grindNotes      String?     @db.Text
  extractionNotes String?     @db.Text
  aromaRating     Int?        @db.SmallInt
  acidityRating   Int?        @db.SmallInt
  bodyRating      Int?        @db.SmallInt
  aftertasteRating Int?       @db.SmallInt
  
  // Timestamps
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  // Validation
  @@check("aroma_rating IS NULL OR (aroma_rating >= 1 AND aroma_rating <= 5)")
  @@check("acidity_rating IS NULL OR (acidity_rating >= 1 AND acidity_rating <= 5)")
  @@check("body_rating IS NULL OR (body_rating >= 1 AND body_rating <= 5)")
  @@check("aftertaste_rating IS NULL OR (aftertaste_rating >= 1 AND aftertaste_rating <= 5)")
  
  @@map("brew_feedback")
}

// Analytics view for quick queries
view GrinderAnalytics {
  grinderId       String
  sessionsCount   Int
  avgRating       Float?
  mostUsedSetting Int
  bean            String?
  
  @@map("grinder_analytics")
}

